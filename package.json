{
  "name": "hamichlol-offline",
  "version": "1.0.0",
  "description": "אפליקציית אלקטרון עם MediaWiki מקומית",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set DEV_MODE=true&& electron .",
    "test": "mocha \"test/**/*.test.js\"",
    "test:system": "mocha \"test/system/*.system.js\"",
    "test:e2e": "mocha \"test/e2e/*.e2e.js\"",
    "test:all": "npm test && npm run test:system && npm run test:e2e",
    "coverage": "c8 --reporter=text --reporter=html mocha \"test/**/*.test.js\"",
    "check-downloads": "node scripts/check-downloads.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^4.3.7",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "mocha": "^12.0.3",
    "playwright-core": "^1.65.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "mysql2": "^3.24.6",
    "portfinder": "^1.0.32"
  },
  "build": {
    "appId": "com.hamichlol.offline",
    "productName": "המכלול אופליין",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
